# Copia este archivo como .env.local para probar en tu computadora. NUNCA subas .env.local a GitHub.
# En Vercel, estas variables se ponen en Settings > Environment Variables.

# URL pública del sitio, sin barra al final. En Vercel es opcional: si falta, se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# Código de verificación de Google Search Console (método "Etiqueta HTML": solo el valor de content="...").
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
