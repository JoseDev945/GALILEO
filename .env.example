# Copia este archivo como .env.local y rellena los valores. NUNCA subas .env.local a GitHub.

# Cadena de conexión de Neon (Dashboard de Neon > Connect > "Pooled connection")
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Texto aleatorio largo para anonimizar IPs (genera uno con: openssl rand -hex 32)
IP_HASH_SALT="cambia-esto-por-un-valor-aleatorio"

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"
